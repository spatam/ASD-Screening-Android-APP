<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Deve derivare da MaterialComponents: l'app usa AppCompatActivity
         e LinearProgressIndicator, che senza un tema Material va in crash. -->
    <style name="Theme.ASDScreening" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/unict_orange</item>
        <item name="colorPrimaryVariant">#FFC04A28</item>
        <item name="colorOnPrimary">#FFFFFFFF</item>
        <item name="colorSecondary">@color/unict_orange</item>
        <item name="colorOnSecondary">#FFFFFFFF</item>
        <!-- Sfondo nero per gli stimoli, barre di sistema scure -->
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
</resources>