<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Must extend MaterialComponents: AppCompatActivity and LinearProgressIndicator
         crash without a Material theme. -->
    <style name="Theme.ASDScreening" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/unict_orange</item>
        <item name="colorPrimaryVariant">#FFC04A28</item>
        <item name="colorOnPrimary">#FFFFFFFF</item>
        <item name="colorSecondary">@color/unict_orange</item>
        <item name="colorOnSecondary">#FFFFFFFF</item>
        <!-- Black background behind the stimuli, dark system bars (Android 14 and older). -->
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
</resources>