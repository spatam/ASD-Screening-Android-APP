<?xml version="1.0" encoding="utf-8"?>
<!-- Branding card shown by MainActivity before the test and on the final result.
     It is hidden during calibration and stimuli so it does not attract fixations. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/brandingCard"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_branding_card"
    android:elevation="6dp"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="20dp"
    android:paddingEnd="24dp"
    android:paddingBottom="20dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/branding_logo_dmi_desc"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_unict_dmi" />

        <Space
            android:layout_width="24dp"
            android:layout_height="1dp" />

        <ImageView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/branding_logo_seal_desc"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_unict_seal" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="@string/branding_university"
        android:textColor="@color/branding_text_dark"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="@string/branding_department"
        android:textColor="@color/unict_orange"
        android:textSize="15sp"
        android:textStyle="bold" />

    <View
        android:layout_width="120dp"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="#33000000" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/branding_author"
        android:textColor="@color/branding_text_dark"
        android:textSize="14sp"
        android:textStyle="italic" />
</LinearLayout>
